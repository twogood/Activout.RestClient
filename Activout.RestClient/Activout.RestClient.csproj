<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>default</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS0618;CS0619</WarningsNotAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>Activout Rest Client</Title>
    <Description>Create a REST(ish) API client only by defining the C# interface you want.</Description>
    <PackageTags>rest;rest-client;http;api;client;interface;code-generation;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <None Include="README.md" Pack="true" PackagePath="\"/>
    <InternalsVisibleTo Include="Activout.RestClient.Test" />
  </ItemGroup>
</Project>
